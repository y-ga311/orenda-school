# Supabase（.env.local にコピーして値を設定）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# students.name の pgp_sym_encrypt 復号キー（amt_exam-portal-main と同一）
STUDENT_NAME_ENCRYPTION_KEY=
# 旧キーで暗号化された氏名がある場合のみ（任意）
STUDENT_NAME_ENCRYPTION_KEY_LEGACY=
# 復号 RPC セットアップ用（任意）scripts/apply-decrypt-student-name-function.mjs
SUPABASE_DB_URL=
# 本番: Vercel に STUDENT_NAME_ENCRYPTION_KEY 未設定の場合は
# docs/sql/set-student-name-encryption-key.sql を Supabase で実行
